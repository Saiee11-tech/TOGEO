<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TOGEO</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #111;
    color: white;
    height: 100vh;
}

.app {
    max-width: 500px;
    height: 100vh;
    margin: auto;
    background: #181818;
    display: flex;
    flex-direction: column;
}

/* HEADER */
.header {
    padding: 18px;
    background: #202020;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 2px;
}

.icon {
    font-size: 22px;
}

/* SEARCH */
.search {
    padding: 10px;
    background: #202020;
}

.search input {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 20px;
    background: #303030;
    color: white;
    outline: none;
}

/* CONTENT */
.content {
    flex: 1;
    overflow-y: auto;
    padding-bottom: 70px;
}

.section {
    display: none;
}

.section.active {
    display: block;
}

/* CHAT */
.chat {
    display: flex;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid #292929;
    cursor: pointer;
}

.avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #555;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    font-size: 20px;
}

.chat-info {
    flex: 1;
}

.chat-name {
    font-weight: bold;
}

.last-message {
    color: #aaa;
    font-size: 14px;
    margin-top: 5px;
}

.time {
    color: #888;
    font-size: 12px;
}

/* TOGETHER */
.together-box {
    margin: 20px;
    padding: 25px;
    background: #252525;
    border-radius: 18px;
    text-align: center;
}

.together-box h2 {
    margin-bottom: 10px;
}

.together-box p {
    color: #aaa;
    margin-bottom: 20px;
}

.btn {
    border: none;
    padding: 13px 20px;
    border-radius: 25px;
    background: #fff;
    color: #111;
    font-weight: bold;
    cursor: pointer;
}

.btn:hover {
    opacity: 0.8;
}

/* STATUS */
.status {
    padding: 18px;
    border-bottom: 1px solid #292929;
}

.status-circle {
    width: 55px;
    height: 55px;
    border-radius: 50%;
    border: 3px solid #fff;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* SETTINGS */
.setting {
    padding: 18px;
    border-bottom: 1px solid #292929;
    cursor: pointer;
}

/* BOTTOM NAV */
.nav {
    height: 65px;
    background: #202020;
    display: flex;
    justify-content: space-around;
    align-items: center;
    position: fixed;
    bottom: 0;
    width: 100%;
    max-width: 500px;
}

.nav button {
    background: none;
    border: none;
    color: #aaa;
    font-size: 12px;
    cursor: pointer;
}

.nav button span {
    display: block;
    font-size: 22px;
    margin-bottom: 3px;
}

.nav button.active {
    color: white;
}

/* CHAT SCREEN */
.chat-screen {
    display: none;
    position: fixed;
    inset: 0;
    background: #181818;
    max-width: 500px;
    margin: auto;
    flex-direction: column;
}

.chat-header {
    padding: 15px;
    background: #202020;
    display: flex;
    align-items: center;
}

.back {
    font-size: 25px;
    margin-right: 15px;
    cursor: pointer;
}

.chat-messages {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
}

.message {
    background: #303030;
    padding: 10px 14px;
    border-radius: 15px;
    margin-bottom: 10px;
    width: fit-content;
    max-width: 75%;
}

.message.me {
    margin-left: auto;
    background: #fff;
    color: #111;
}

.chat-input {
    display: flex;
    padding: 10px;
    background: #202020;
}

.chat-input input {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 20px;
    background: #303030;
    color: white;
    outline: none;
}

.send {
    margin-left: 8px;
    border: none;
    border-radius: 50%;
    width: 45px;
    background: white;
    cursor: pointer;
}
</style>
</head>

<body>

<div class="app">

    <!-- HEADER -->
    <div class="header">
        <div class="logo">TOGEO</div>
        <div class="icon">⌕</div>
    </div>

    <!-- SEARCH -->
    <div class="search">
        <input
            type="text"
            id="search"
            placeholder="Search..."
            onkeyup="searchChats()">
    </div>

    <div class="content">

        <!-- CHATS -->
        <div id="chats" class="section active">

            <div class="chat" onclick="openChat('Priya')">
                <div class="avatar">P</div>
                <div class="chat-info">
                    <div class="chat-name">Priya</div>
                    <div class="last-message">Let's watch something 🎬</div>
                </div>
                <div class="time">10:30</div>
            </div>

            <div class="chat" onclick="openChat('Rahul')">
                <div class="avatar">R</div>
                <div class="chat-info">
                    <div class="chat-name">Rahul</div>
                    <div class="last-message">Bro, join the room</div>
                </div>
                <div class="time">09:45</div>
            </div>

            <div class="chat" onclick="openChat('Neha')">
                <div class="avatar">N</div>
                <div class="chat-info">
                    <div class="chat-name">Neha</div>
                    <div class="last-message">❤️</div>
                </div>
                <div class="time">Yesterday</div>
            </div>

        </div>

        <!-- FRIENDS -->
        <div id="friends" class="section">

            <div class="chat">
                <div class="avatar">A</div>
                <div class="chat-info">
                    <div class="chat-name">Aarav</div>
                    <div class="last-message">Online</div>
                </div>
            </div>

            <div class="chat">
                <div class="avatar">S</div>
                <div class="chat-info">
                    <div class="chat-name">Sneha</div>
                    <div class="last-message">Online</div>
                </div>
            </div>

        </div>

        <!-- TOGETHER -->
        <div id="together" class="section">

            <div class="together-box">
                <h2>🎬 Watch Together</h2>
                <p>Watch videos together while chatting in real time.</p>
                <button class="btn" onclick="createRoom()">
                    Create Room
                </button>
            </div>

            <div class="together-box">
                <h2>🎵 Listen Together</h2>
                <p>Listen to music together with your friends.</p>
                <button class="btn" onclick="createRoom()">
                    Start Listening
                </button>
            </div>

        </div>

        <!-- STATUS -->
        <div id="status" class="section">

            <div class="status">
                <div class="status-circle">+</div>
                <h3 style="margin-top:10px;">My Status</h3>
                <p style="color:#888;">Add a new status</p>
            </div>

            <div class="status">
                <b>Priya</b>
                <p style="color:#888;margin-top:5px;">
                    Watching something 🎬
                </p>
            </div>

        </div>

        <!-- SETTINGS -->
        <div id="settings" class="section">

            <div class="setting">👤 Account</div>
            <div class="setting">🔒 Privacy</div>
            <div class="setting">🔔 Notifications</div>
            <div class="setting">🎨 Theme</div>
            <div class="setting">ℹ️ About TOGEO</div>

        </div>

    </div>

    <!-- BOTTOM NAV -->
    <div class="nav">

        <button class="active" onclick="showSection('chats',this)">
            <span>💬</span>
            Chats
        </button>

        <button onclick="showSection('friends',this)">
            <span>👥</span>
            Friends
        </button>

        <button onclick="showSection('together',this)">
            <span>🎬</span>
            Together
        </button>

        <button onclick="showSection('status',this)">
            <span>⭕</span>
            Status
        </button>

        <button onclick="showSection('settings',this)">
            <span>⚙️</span>
            Settings
        </button>

    </div>

</div>


<!-- CHAT SCREEN -->

<div id="chatScreen" class="chat-screen">

    <div class="chat-header">

        <div class="back" onclick="closeChat()">‹</div>

        <div class="avatar" id="chatAvatar">P</div>

        <div>
            <b id="chatPerson">Priya</b>
            <div style="font-size:12px;color:#888;">
                online
            </div>
        </div>

    </div>

    <div class="chat-messages" id="messages">

        <div class="message">
            Hey! 👋
        </div>

        <div class="message">
            Want to watch something together?
        </div>

    </div>

    <div class="chat-input">

        <input
            type="text"
            id="messageInput"
            placeholder="Message..."
            onkeydown="handleEnter(event)">

        <button class="send" onclick="sendMessage()">
            ➤
        </button>

    </div>

</div>


<script>

/* NAVIGATION */

function showSection(id, button) {

    document.querySelectorAll(".section")
        .forEach(section => {
            section.classList.remove("active");
        });

    document.getElementById(id)
        .classList.add("active");

    document.querySelectorAll(".nav button")
        .forEach(btn => {
            btn.classList.remove("active");
        });

    button.classList.add("active");
}


/* OPEN CHAT */

function openChat(name) {

    document.getElementById("chatPerson")
        .innerText = name;

    document.getElementById("chatAvatar")
        .innerText = name.charAt(0);

    document.getElementById("chatScreen")
        .style.display = "flex";
}


/* CLOSE CHAT */

function closeChat() {

    document.getElementById("chatScreen")
        .style.display = "none";
}


/* SEND MESSAGE */

function sendMessage() {

    const input =
        document.getElementById("messageInput");

    const text = input.value.trim();

    if (text === "") return;

    const message =
        document.createElement("div");

    message.className = "message me";

    message.innerText = text;

    document.getElementById("messages")
        .appendChild(message);

    input.value = "";

    const messages =
        document.getElementById("messages");

    messages.scrollTop = messages.scrollHeight;
}


/* ENTER TO SEND */

function handleEnter(event) {

    if (event.key === "Enter") {
        sendMessage();
    }
}


/* CREATE ROOM */

function createRoom() {

    const roomCode =
        Math.random()
        .toString(36)
        .substring(2, 8)
        .toUpperCase();

    alert(
        "TOGEO Room Created!\n\nRoom Code: "
        + roomCode
        + "\n\nShare this code with your friend."
    );
}


/* SEARCH */

function searchChats() {

    const input =
        document.getElementById("search")
        .value.toLowerCase();

    const chats =
        document.querySelectorAll("#chats .chat");

    chats.forEach(chat => {

        const name =
            chat.querySelector(".chat-name")
            .innerText
            .toLowerCase();

        if (name.includes(input)) {
            chat.style.display = "flex";
        } else {
            chat.style.display = "none";
        }

    });
}

</script>

</body>
</html>